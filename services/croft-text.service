# croft-text.service — systemd unit for the text chat server (server mode).
#
# Linux only (systemd). macOS has no systemd: use ./webui.sh, or adapt the
# launchd template in services/croft-manager.plist.
#
# llama-server has no authentication of any kind, so it binds to 127.0.0.1.
# Changing that publishes an open inference endpoint to your whole network.
#
# Install (user scope, no root):
#   mkdir -p ~/.config/systemd/user
#   cp services/croft-text.service ~/.config/systemd/user/
#   # edit WorkingDirectory / ExecStart paths below to match your install
#   systemctl --user daemon-reload
#   systemctl --user enable --now croft-text.service
#   loginctl enable-linger "$USER"        # keep running after logout
#
# Install (system scope, root):
#   sudo cp services/croft-text.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now croft-text.service
#
# Manage:
#   systemctl --user status  croft-text
#   systemctl --user restart croft-text
#   systemctl --user stop    croft-text
#   journalctl --user -u croft-text -f      # live logs

[Unit]
Description=Croft — text server (llama.cpp)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/croft
Environment=HF_HOME=%h/croft/models/.hf-cache
ExecStart=%h/croft/third_party/llama.cpp/build/bin/llama-server \
    -m %h/croft/models/mistral-7b-q4/mistral-7b-instruct-v0.2.Q4_K_M.gguf \
    -c 4096 --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5
# Hardening (relax if the model path lives outside HOME)
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=default.target
