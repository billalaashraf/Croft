# Croft — every environment variable it reads, with its default.
#
# Copy to `.env` and edit if you want them in one place. Croft does NOT load
# `.env` automatically (there is no dependency on python-dotenv in the core):
# export them yourself, or source the file before starting.
#
#     set -a && . ./.env && set +a && ./webui.sh start
#
# `.env` is gitignored; this file is not. Never put a token in this one.
#
# Every variable below is commented out and shows the built-in default, so an
# uncommented line always means "I am deliberately changing this".


# ---------------------------------------------------------------------------
# Paths
# ---------------------------------------------------------------------------
# Where weights, chat.db, installed.json, uploads/ and sd-outputs/ live.
# Relative paths are resolved against the install directory.
#LLM_MODELS_DIR=models

# Where the bootstrap installs Croft when it is not run from a checkout.
#LLM_INSTALL_DIR=$HOME/croft

# Virtualenv location used by webui.sh.
#LLM_VENV_DIR=./.venv


# ---------------------------------------------------------------------------
# Hugging Face
# ---------------------------------------------------------------------------
# Read-scope token, required only for gated repos (Llama, SVD).
# Put this in `.env`, never here. `huggingface-cli login` is the alternative.
#HF_TOKEN=
#HUGGING_FACE_HUB_TOKEN=


# ---------------------------------------------------------------------------
# Web app (webui/app.py)
# ---------------------------------------------------------------------------
# Bind address. 0.0.0.0 publishes the app to every network this machine is on —
# read docs/SECURITY.md before doing that, and set LLM_WEBUI_TOKEN yourself.
#LLM_WEBUI_HOST=127.0.0.1
#LLM_WEBUI_PORT=8090

# Access token for /api/*. Generated into .webui_token (mode 0600) when unset.
# Set it explicitly if you bind to anything other than loopback.
#LLM_WEBUI_TOKEN=
#LLM_WEBUI_TOKEN_FILE=./.webui_token

# Extra comma-separated hostnames the Host allow-list will accept. Needed if you
# reach the app by a name rather than an IP under a wildcard bind.
#LLM_WEBUI_ALLOWED_HOSTS=

# webui.sh target: `native` drives a local uvicorn, `docker` the compose service.
#LLM_WEBUI_MODE=native

# Set to 1 to stop the bootstrap launching the web app at the end.
#LLM_NO_WEBUI=


# ---------------------------------------------------------------------------
# Chat
# ---------------------------------------------------------------------------
# SQLite history database.
#LLM_CHAT_DB=<LLM_MODELS_DIR>/chat.db

# Bearer token sent to an OpenAI-compatible endpoint that requires one.
#LLM_CHAT_API_KEY=

# Ollama, when used as a backend.
#LLM_OLLAMA_HOST=http://127.0.0.1:11434
#LLM_OLLAMA_UNLOAD_WAIT=8
#LLM_OLLAMA_UNLOAD_SETTLE=1.5


# ---------------------------------------------------------------------------
# Attachments (webui/files.py)
# ---------------------------------------------------------------------------
# Hard cap on an uploaded file, in bytes (25 MB).
#LLM_FILE_MAXBYTES=26214400

# Characters of extracted text folded into the prompt. The cap is what stops a
# large PDF overflowing the model's context.
#LLM_FILE_MAXCHARS=16000


# ---------------------------------------------------------------------------
# Image and video generation
# ---------------------------------------------------------------------------
# The diffusion worker (webui/sd_server.py) and the client that talks to it.
#LLM_SD_HOST=127.0.0.1
#LLM_SD_PORT=7862
#LLM_SD_URL=http://127.0.0.1:7862
#LLM_SD_TIMEOUT=3600

# Force a dtype. Set float32 if fp16 produces black images on MPS.
#LLM_SD_DTYPE=float16      # float32 on CPU

# VRAM a pipeline is assumed to need before Croft will load it.
#LLM_IMAGE_NEED_GIB=8
#LLM_IMAGE_NEED_GIB_FP32=16
#LLM_VIDEO_NEED_GIB=10

# Attention slicing granularity — lower trades speed for less peak memory.
#LLM_ATTN_SLICE_ROWS=32

# Set 0 to keep every model resident instead of evicting to free VRAM.
#LLM_GPU_EVICT=1

# SD1.5 base that AnimateDiff rides on.
#LLM_ANIMATEDIFF_BASE=runwayml/stable-diffusion-v1-5


# ---------------------------------------------------------------------------
# Bootstrap installer
# ---------------------------------------------------------------------------
# Where the bootstrap fetches Croft from when not run inside a checkout.
#LLM_REPO_URL=https://github.com/billalaashraf/Croft
#LLM_PKG_URL=
#LLM_PKG_SHA256=

# Set 1 to resolve requirements.txt fresh instead of using requirements.lock.
#LLM_NO_LOCK=0

# Set 1 to skip installing the inference engines (torch/diffusers/llama-cpp).
#LLM_NO_ENGINES=


# ---------------------------------------------------------------------------
# Docker compose only
# ---------------------------------------------------------------------------
#TEXT_MODEL_ID=
#TGI_QUANTIZE=
#GGUF_FILE=
#OLLAMA_KEEP_ALIVE=2m
