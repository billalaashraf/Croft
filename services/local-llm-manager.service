# local-llm-manager.service — systemd unit for the FastAPI status/control panel.
#
# Linux only. On macOS use ./webui.sh start, or the launchd template in
# services/local-llm-manager.plist.
#
#   cp services/local-llm-manager.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now local-llm-manager
#   # then open the URL the app logs on startup — it carries the access token:
#   journalctl --user -u local-llm-manager | grep 'open:'

[Unit]
Description=Local LLM Chat — manager web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/local-llm-chat
Environment=LLM_MODELS_DIR=%h/local-llm-chat/models
# Loopback. This panel can start and stop services; a 0.0.0.0 bind published it
# to the whole network. To reach it from another machine, set LLM_WEBUI_HOST
# AND LLM_WEBUI_ALLOWED_HOSTS here and read docs/SECURITY.md first.
ExecStart=%h/local-llm-chat/.venv/bin/uvicorn webui.app:app --host 127.0.0.1 --port 8090
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=default.target
