<?xml version="1.0" encoding="UTF-8"?>
<!--
  croft-manager.plist — launchd agent for the web app on macOS.

  macOS has no systemd, so the .service files in this directory do nothing
  here. This is the equivalent: a per-user LaunchAgent, which is the right
  scope — it needs no root, and it stops when you log out.

  Install (replace USERNAME, or run the sed line):
    sed "s|/Users/USERNAME|$HOME|g" services/croft-manager.plist \
      > ~/Library/LaunchAgents/com.croft.manager.plist
    launchctl load ~/Library/LaunchAgents/com.croft.manager.plist

  The access token is in the startup log; the URL that carries it is:
    grep 'open:' ~/croft/logs/manager.out.log | tail -1

  Manage:
    launchctl list | grep croft
    launchctl unload ~/Library/LaunchAgents/com.croft.manager.plist

  Note the bind address below is 127.0.0.1. This panel can start and stop
  services; do not publish it to the network without reading docs/SECURITY.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.croft.manager</string>

  <!-- Through the interpreter, not .venv/bin/uvicorn: a console script bakes
       the creating venv's absolute path into its shebang, so a moved checkout
       leaves it present but unrunnable. `python -m uvicorn` survives that. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/USERNAME/croft/.venv/bin/python</string>
    <string>-m</string>
    <string>uvicorn</string>
    <string>webui.app:app</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8090</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/USERNAME/croft</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>LLM_MODELS_DIR</key>
    <string>/Users/USERNAME/croft/models</string>
    <key>HF_HOME</key>
    <string>/Users/USERNAME/croft/models/.hf-cache</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <!-- Restart on a crash, but not on a clean stop — otherwise `launchctl
         stop` fights the agent and it comes straight back. -->
    <key>SuccessfulExit</key>
    <false/>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/USERNAME/croft/logs/manager.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/USERNAME/croft/logs/manager.err.log</string>
</dict>
</plist>
