{
  "manifest_version": "1.0",
  "description": "Model catalog for Croft. Each entry drives recommendation, download, and integrity verification. SHA256 values apply to single-file (GGUF/direct) downloads; HF snapshot repos are verified by commit hash + per-file ETag and use \"integrity_sha256\": null.",
  "schema": {
    "id": "string  — unique, kebab-case identifier used by the CLI",
    "kind": "string — text | image | video",
    "source_url": "string — canonical Hugging Face or GitHub URL",
    "hf_repo": "string — repo id for huggingface_hub (omit if direct URL)",
    "revision": "string|null — Hugging Face commit SHA to download. Pinning it makes an install reproducible: `main` moves, and an upstream force-push would otherwise silently change the weights you get. null only for direct-URL entries, which are pinned by integrity_sha256 instead.",
    "download_url": "string|null — direct file URL for single-file GGUF (else null)",
    "license": "string — SPDX-ish id or license name",
    "gated": "bool — true if HF license acceptance + token required before download",
    "params": "number — parameter count (absolute, e.g. 7000000000)",
    "size_bytes": "number — on-disk footprint of the listed weights",
    "quantized_formats_available": "string[] — e.g. [\"int4\",\"int8\",\"fp16\"]",
    "format": "string — gguf | gptq | safetensors | diffusers",
    "recommended_min_vram_GB": "number — minimum VRAM for comfortable use",
    "recommended_mode": "string — docker | native | cpu-only",
    "integrity_sha256": "string|null — SHA256 of download_url file, or null for snapshot repos",
    "hf_allow_patterns": "string[]|null — glob filter for snapshot downloads; null pulls the whole repo. GGUF repos hold every quantisation, so an unfiltered snapshot can be 10x the advertised size. Patterns are matched case-sensitively, hence both Q4_K_M and q4_k_m."
  },
